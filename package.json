{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "ai:dev": "tsx scripts/ai-dev.ts",
    "build": "vite build",
    "preview": "tsx server/index.ts --preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:files && npm run test:pdf-reader",
    "test:files": "node scripts/check-file-lengths.mjs",
    "test:pdf-reader": "tsx --test server/ai-attachments/pdf-content.test.ts shared/ai-pdf-reader-contract.test.ts src/components/ai-tab/live-turn.test.ts src/components/ai-tab/thinking-turn.test.ts src/components/ai-tab/tools/pdf-reader-tool.test.ts src/components/ai-tab/tools/result-persistence.test.ts src/lib/ai-attachments-storage.test.ts src/lib/ollama/runtime.test.ts",
    "searxng:up": "docker compose -f docker-compose.searxng.yml up -d",
    "searxng:down": "docker compose -f docker-compose.searxng.yml down"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-character-count": "^3.24.0",
    "@tiptap/extension-color": "^3.24.0",
    "@tiptap/extension-font-family": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-horizontal-rule": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-subscript": "^3.24.0",
    "@tiptap/extension-superscript": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/extension-task-item": "^3.24.0",
    "@tiptap/extension-task-list": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "dexie": "^4.4.3",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.17.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
