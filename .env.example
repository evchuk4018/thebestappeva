# The AI tab defaults to Ollama and can optionally use DeepSeek BYOK.
# Keep Ollama available locally at http://127.0.0.1:11434 for the default setup.
# DeepSeek keys must stay server-side in .env and are never exposed to the browser.
# Run SearXNG locally with `docker compose -f docker-compose.searxng.yml up -d`.
# Or run `npm run ai:dev` to require Ollama + qwen3.5:9b + SearXNG before the app starts.

MODEL_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
MODEL_LABEL=Qwen 3.5 9B
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_LABEL=DeepSeek V4 Flash
SEARXNG_BASE_URL=http://127.0.0.1:8888
PORT=3000
LOCAL_DB_PATH=.local-data/thebestappeva.sqlite
AI_ATTACHMENT_STORAGE_PATH=.local-data/ai-attachments
AI_ATTACHMENT_MAX_UPLOAD_BYTES=20971520
AI_ATTACHMENT_INLINE_CHARS=12000
AI_ATTACHMENT_MAX_CONTEXT_CHARS=18000
AI_ATTACHMENT_TOP_CHUNKS=6
AI_PDF_RENDER_SCALE=1.5
AI_PARSER_TIMEOUT_MS=120000
AI_PARSER_PYTHON_COMMAND=
AI_PARSER_PYTHON_ARGS=
WEB_SEARCH_TIMEOUT_MS=10000
URL_FETCH_TIMEOUT_MS=12000
WEB_SEARCH_MAX_RESULTS=8
URL_FETCH_MAX_CHARS=12000
